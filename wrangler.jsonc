{
  // Static site on Cloudflare Workers (assets only, no Worker code). Build: npm run build -> dist/.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dota-lastpick",
  "compatibility_date": "2026-11-04",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
